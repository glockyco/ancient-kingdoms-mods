# Ancient Kingdoms Compendium build-pipeline configuration
#
# Run 'dotnet run --project build-tool setup' to create config.toml.

[paths]
# Data export directory, relative to the repository root.
# Match this directory to DATA_EXPORT_PATH in Local.props. MSBuild generates
# ExportConfig.g.cs under DataExporter's obj/ directory from that property.
export_dir = "./exported-data"

# Website source directory (relative to repository root)
website_dir = "./website"


[build_pipeline]
# Database settings
db_name = "compendium.db"

# Map tile generation
[build_pipeline.tiles]
min_zoom = -3
max_zoom = 3
tile_size = 256

# WebP quality for map tiles (1-100, higher = better quality but larger files)
# Recommended: 85 for good balance between quality and size
webp_quality = 85
