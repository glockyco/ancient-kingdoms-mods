<Project Sdk="Microsoft.NET.Sdk">
  <!-- The update code the plugin loads. Pocket Compendium carries it and rewrites it when it changes. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>PocketCompendium.UpdateCore</AssemblyName>
    <RootNamespace>PocketCompendium.UpdateCore</RootNamespace>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..'))=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MelonLoaderPath)\net6\MelonLoader.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <Import Project="..\Shared\Updates\Updates.props" />
</Project>
