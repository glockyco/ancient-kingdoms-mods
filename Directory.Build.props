<Project>

  <!-- Import local configuration (git-ignored) -->
  <Import Project="Local.props" Condition="Exists('Local.props')" />

  <PropertyGroup>
    <!--
      A project that references the game's own assemblies cannot build without the
      install. A project that only compiles repository sources can, so it sets this
      to false and stays buildable on a machine with no game and no Local.props -
      which is what lets the test projects run in CI.
    -->
    <RequiresGameInstall Condition="'$(RequiresGameInstall)' == ''">true</RequiresGameInstall>

    <!-- Derive paths from ANCIENT_KINGDOMS_PATH -->
    <MelonLoaderPath Condition="'$(MelonLoaderPath)' == ''">$(ANCIENT_KINGDOMS_PATH)\MelonLoader</MelonLoaderPath>
    <Il2CppAssembliesPath Condition="'$(Il2CppAssembliesPath)' == ''">$(MelonLoaderPath)\Il2CppAssemblies</Il2CppAssembliesPath>
    <ModsPath Condition="'$(ModsPath)' == ''">$(ANCIENT_KINGDOMS_PATH)\Mods</ModsPath>

    <!--
      HotRepl cross-repo reference.
      Default: sibling checkout ../HotRepl. Override with HOTREPL_REPO_PATH in Local.props
      if your checkout lives elsewhere — same pattern as MelonLoaderPath above.
      Source: devblogs.microsoft.com/ise/dotnet-multi-repo
    -->
    <HotReplRepoPath Condition="'$(HOTREPL_REPO_PATH)' != ''">$(HOTREPL_REPO_PATH)</HotReplRepoPath>
    <HotReplRepoPath Condition="'$(HotReplRepoPath)' == ''">$(MSBuildThisFileDirectory)..\HotRepl</HotReplRepoPath>
    <HotReplCoreOutput>$(HotReplRepoPath)\src\HotRepl.Core\bin\Debug\netstandard2.1</HotReplCoreOutput>
  </PropertyGroup>

  <!-- Validate required paths are set -->
  <Target Name="ValidatePaths" BeforeTargets="BeforeBuild"
          Condition="'$(RequiresGameInstall)' == 'true'">
    <Error Condition="'$(ANCIENT_KINGDOMS_PATH)' == '' And !Exists('Local.props')"
           Text="Local.props not found. Copy Local.props.example to Local.props and set ANCIENT_KINGDOMS_PATH." />
    <Error Condition="'$(ANCIENT_KINGDOMS_PATH)' == ''"
           Text="ANCIENT_KINGDOMS_PATH not set in Local.props. Check your configuration." />
  </Target>

</Project>
