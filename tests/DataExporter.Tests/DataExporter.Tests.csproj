<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compiles repository sources only; the game install is not a build input. -->
    <RequiresGameInstall>false</RequiresGameInstall>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Keep dotnet test on the VSTest adapter instead of MTP. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\mods\DataExporter\Sessions\*.cs" Link="Sessions\%(Filename)%(Extension)" />
    <Compile Include="..\..\build-tool\Game\SteamAppManifest.cs" Link="Sessions\SteamAppManifest.cs" />
    <Compile Include="..\..\mods\DataExporter\GameIds.cs" Link="GameIds.cs" />
    <Compile Include="..\..\mods\DataExporter\PlacementIds.cs" Link="PlacementIds.cs" />
    <Compile Include="..\..\mods\DataExporter\RecipeDefinitionKeys.cs" Link="RecipeDefinitionKeys.cs" />
    <Compile Include="..\..\mods\DataExporter\ConfiguredValues.cs" Link="ConfiguredValues.cs" />
    <Compile Include="..\..\mods\DataExporter\ExportJson.cs" Link="ExportJson.cs" />
    <Compile Include="..\..\mods\DataExporter\ZoneBoundary.cs" Link="ZoneBoundary.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\RecipeOfferData.cs" Link="Models\RecipeOfferData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\MonsterData.cs" Link="Models\MonsterData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\PortalData.cs" Link="Models\PortalData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\SummonTriggerData.cs" Link="Models\SummonTriggerData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\NpcData.cs" Link="Models\NpcData.cs" />
    <Compile Include="..\..\mods\DataExporter\Exporters\EquipmentSlotRows.cs" Link="Exporters\EquipmentSlotRows.cs" />
    <Compile Include="..\..\mods\DataExporter\Exporters\ProgressionRows.cs" Link="Exporters\ProgressionRows.cs" />
    <Compile Include="..\..\mods\DataExporter\Exporters\TooltipNormalizer.cs" Link="Exporters\TooltipNormalizer.cs" />
    <Compile Include="..\..\mods\DataExporter\StatCatalog.cs" Link="StatCatalog.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\StatData.cs" Link="Models\StatData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\ItemData.cs" Link="Models\ItemData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\SkillData.cs" Link="Models\SkillData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\ClassData.cs" Link="Models\ClassData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\PetData.cs" Link="Models\PetData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\Position.cs" Link="Models\Position.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\EquipmentSlotData.cs" Link="Models\EquipmentSlotData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\ProgressionData.cs" Link="Models\ProgressionData.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\ExporterRunError.cs" Link="Models\ExporterRunError.cs" />
    <Compile Include="..\..\mods\DataExporter\Models\ExporterRunResult.cs" Link="Models\ExporterRunResult.cs" />
