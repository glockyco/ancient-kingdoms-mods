<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- Keep dotnet test on the VSTest adapter instead of MTP. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Compiles repository sources only; the game install is not a build input. -->
    <RequiresGameInstall>false</RequiresGameInstall>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\mods\BetterBestiary\Skills\LinearValue.cs" Link="Skills\LinearValue.cs" />
    <Compile Include="..\..\mods\BetterBestiary\Skills\SkillEffectInput.cs" Link="Skills\SkillEffectInput.cs" />
    <Compile Include="..\..\mods\BetterBestiary\Skills\SkillEffectFormatter.cs" Link="Skills\SkillEffectFormatter.cs" />
    <Compile Include="..\..\mods\BetterBestiary\Ui\LootGridLayout.cs" Link="Ui\LootGridLayout.cs" />
    <Compile Include="..\..\mods\Shared\ZoneNames.cs" Link="Shared\ZoneNames.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fixtures\skill-effect-parity.json" LogicalName="skill-effect-parity.json" />
  </ItemGroup>
</Project>
