<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Compiles repository sources only; the game install is not a build input. -->
    <RequiresGameInstall>false</RequiresGameInstall>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit"                  Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
    <PackageReference Include="Newtonsoft.Json"        Version="13.0.4" />
  </ItemGroup>

  <!-- Production source files with no game-assembly dependencies, compiled directly -->
  <ItemGroup>
    <Compile Include="..\..\mods\DataExporter\GameIds.cs"
             Link="GameIds.cs" />
    <Compile Include="..\..\mods\CombatVerification\Fixtures\BuildEnvelope.cs"
             Link="Fixtures\BuildEnvelope.cs" />
    <Compile Include="..\..\mods\CombatVerification\Fixtures\FixtureDescriptor.cs"
             Link="Fixtures\FixtureDescriptor.cs" />
    <Compile Include="..\..\mods\CombatVerification\Fixtures\IFixtureRules.cs"
             Link="Fixtures\IFixtureRules.cs" />
    <Compile Include="..\..\mods\CombatVerification\Fixtures\FixtureShapeValidator.cs"
             Link="Fixtures\FixtureShapeValidator.cs" />
    <Compile Include="..\..\mods\CombatVerification\Fixtures\FixtureValidator.cs"
             Link="Fixtures\FixtureValidator.cs" />
    <Compile Include="..\..\mods\CombatVerification\Materialization\CreatorMethods.cs"
             Link="Materialization\CreatorMethods.cs" />
    <Compile Include="..\..\mods\CombatVerification\Materialization\ICharacterUnderConstruction.cs"
             Link="Materialization\ICharacterUnderConstruction.cs" />
    <Compile Include="..\..\mods\CombatVerification\Materialization\IEquipmentSurface.cs"
             Link="Materialization\IEquipmentSurface.cs" />
    <Compile Include="..\..\mods\CombatVerification\Probes\ActionTimeline.cs"
             Link="Probes\ActionTimeline.cs" />
    <Compile Include="..\..\mods\CombatVerification\Probes\DamageLog.cs"
             Link="Probes\DamageLog.cs" />
    <Compile Include="..\..\mods\CombatVerification\Probes\TimedEffect.cs"
             Link="Probes\TimedEffect.cs" />
    <Compile Include="..\..\mods\CombatVerification\Probes\Tiers.cs"
             Link="Probes\Tiers.cs" />
    <Compile Include="..\..\mods\CombatVerification\Engine\EquippedSlot.cs"
             Link="Engine\EquippedSlot.cs" />
    <Compile Include="..\..\mods\CombatVerification\Materialization\CharacterBuilder.cs"
             Link="Materialization\CharacterBuilder.cs" />
  </ItemGroup>
</Project>
